# .ngodingpakeaiignore — extra paths to keep out of NgodingPakeAI sync.
# Uses .gitignore syntax. Secrets, node_modules, build output and .env files
# are ALWAYS blocked by the CLI regardless of what is listed here.

# Examples:
# docs/internal/
# *.snap
# fixtures/

# Dokumen contoh asli (PDF/DOCX/XLSX) — bukan kode aplikasi.
REFERENSI/

# Keluaran runtime Laravel (view Blade terkompilasi, cache, sesi, data tiruan) — bukan kode sumber.
# .gitignore bersarang milik Laravel di storage/ tidak dibaca CLI, jadi dicantumkan di sini.
storage/
# Pengaturan agent lokal.
.claude/
