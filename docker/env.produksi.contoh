# Contoh variabel lingkungan produksi SIRABTOR (Docker / Coolify). Salin nilainya ke tab Environment Variables
# Coolify, atau ke berkas `.env` di samping docker-compose.prod.yml untuk server biasa. Panduan: docs/deploy.md.
# Jangan pernah meng-commit nilai asli (APP_KEY, sandi database, kunci API).

# --- Aplikasi -----------------------------------------------------------------------------------------------------
APP_NAME=SIRABTOR
APP_ENV=production
APP_DEBUG=false
# Buat SEKALI: echo "base64:$(openssl rand -base64 32)" (atau php artisan key:generate --show) — lalu JANGAN diganti:
# kunci API penyedia AI tersimpan terenkripsi dengan APP_KEY ini.
APP_KEY=
# Alamat publik (https) persis seperti dibuka pengguna.
APP_URL=https://sirabtor.contoh.sch.id
APP_TIMEZONE=Asia/Jakarta

# Di belakang proksi TLS Coolify/Traefik/nginx: percayai header X-Forwarded-* (https, IP asli pengguna).
SIRABTOR_PROKSI_TEPERCAYA=*

# --- Database (PostgreSQL 18; layanan `db` di docker-compose.prod.yml) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sigenrabtor
DB_USERNAME=sigenrabtor
# Wajib diisi — sandi kuat acak.
DB_PASSWORD=

# --- Sesi, cache, antrean (tabelnya dibuat migrasi) ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
# > --timeout pekerja antrean (360 detik).
DB_QUEUE_RETRY_AFTER=420
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Akun ---------------------------------------------------------------------------------------------------------
# Produksi: semua halaman wajib masuk, tanpa persona demo/masuk tanpa sandi.
SIRABTOR_WAJIB_MASUK=true
SIRABTOR_MODE_DEMO=false
# Admin pertama: php artisan sigenrabtor:atur-sandi <surel> [--buat-admin --nama="…"] (lihat docs/deploy.md).

# --- Mesin dokumen (sudah terpasang di image) ---------------------------------------------------------------------
SIRABTOR_PDF_PERENDER=chrome
SIRABTOR_CHROME=/usr/bin/chromium
SIRABTOR_SOFFICE=/usr/bin/soffice
SIRABTOR_PDF_BATAS_DETIK=90
# Catat setiap unduhan dokumen ke Riwayat Dokumen.
SIRABTOR_CATAT_UNDUHAN=true

# --- Kapasitas PHP-FPM ----------------------------------------------------------------------------------------------
# ±60–100 MB per proses; 10 cukup untuk server 2 GB. Naikkan bila RAM lebih besar.
PHP_FPM_MAX_CHILDREN=10
# Migrasi otomatis saat kontainer mulai (1/0) & lama menunggu database.
SIRABTOR_MIGRASI=1
SIRABTOR_TUNGGU_DB_DETIK=60

# --- AI ------------------------------------------------------------------------------------------------------------
# Penyedia AI (Ollama/Claude/OpenAI/Gemini), model, kunci API, dan batas harian diatur admin di layar
# Pengaturan › Pengaturan AI — tidak lewat variabel lingkungan. Tanpa penyedia aktif aplikasi memakai saran tiruan.
# Ollama di server yang sama (docker-compose.ollama.yml): isi alamat server di Pengaturan AI dengan http://ollama:11434
